{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.automistlabs.googleflow",
  "productName": "Infinity Flow",
  "executableName": "InfinityFlow",
  "copyright": "Copyright © 2026 Automist Labs",
  "directories": {
    "output": "release",
    "buildResources": "assets"
  },
  "files": [
    "dist/**/*",
    "!dist/tests/**/*",
    "assets/**/*",
    "package.json",
    "!scripts/**/*",
    "!**/*.map"
  ],
  "extraResources": [
    {
      "from": "assets/models",
      "to": "models",
      "filter": ["**/*"]
    }
  ],
  "asar": true,
  "asarUnpack": [
    "**/node_modules/playwright/**/*",
    "**/node_modules/playwright-core/**/*",
    "**/node_modules/onnxruntime-node/**/*",
    "**/node_modules/onnxruntime-common/**/*",
    "**/node_modules/global-agent/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/infinity-flow.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Infinity Flow",
    "uninstallDisplayName": "Infinity Flow",
    "deleteAppDataOnUninstall": false
  }
}
